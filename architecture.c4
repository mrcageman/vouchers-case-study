specification {
    element actor {
        style {
            shape person
        }
    }

    element softwareSystem
    element container
    element component

    element boundary
}

model {

    customer = actor "Customer" {
        summary "A customer interacting with our website/apps"
    }

    employee = actor "Employee" {
        summary "e.g. Store clerk"
    }

    hema = softwareSystem "Hema Voucher Platform" {

        apps = component "Website / mobile app" {
            style {
                shape browser
            }
        }

        pos = component "Store POS" {
            style {
                shape mobile
            }
        }

        vms = container "Voucher Management System" {
            description "Creates and updates vouchers in Intersolve. Provides voucher information for e.g. email templates. Also dispatches lifecycle events."
        }

        loyaltyApi = container "Loyalty API" {
            technology "HTTPS"
            description "Handles voucher activation / redemption from apps and pos. After succesful activation publishes voucher event (non-blocking)."
        }

        kafka = container "Kafka" {
            technology "Event Streaming"
            description "Existing event backbone. Now also handles voucher lifecycle events and reminder email events."
            icon tech:kafka
            style {
                shape queue
            }
        }

        ces = container "Customer Engagement Service" {
            description "Consumes events and dispatches customer emails via Selligent."
        }

        dlq = container "Dead-Letter Queue" {
            technology "Kafka topic"
            description "Lifecycle events and reminder emails that keep failing end up here after retries. Nothing is dropped. Parked messages can be inspected and replayed."
            style {
                color red
                shape queue
            }
        }

        reminderService = container "Voucher Reminder Service" {
           description "NEW! Keeps a local view of voucher expiry so daily reminders never have to touch Intersolve or Loyalty API."
            style {
                color green
            }

            sync = component "Event consumer" {
                description "Keeps the local DB in sync from voucher lifecycle events. Event version / status precedence stops late update from reviving redeemed voucher. Recomputes reminder date when voucher's expiry or type changes."
                style {
                    color green
                }
            }

            worker = component "Daily worker" {
                description "Scheduled worker. Finds vouchers due for reminding and publishes reminder events. No external dependency on Intersolve APIs."
                style {
                    color green
                }
            }

            backfill = component "Backfill worker" {
                description "One-time, rate-limited seed for 3.2m existing vouchers in Intersolve."
                style {
                    color green
                }
            }

            reminderDb = component "Reminder database" {
                technology "Database"
                description "Local read model: voucher id, customer id, type, status, expiry, reminder due date, reminder sent, attempts, idempotency key"
                style {
                    shape storage
                    color green
                }
            }

            rules = component "Reminder rules" {
                technology "Configuration"
                description "Reminder timing per voucher type etc. Config, no code changes, so no redeploy required for changes to apply."
                style {
                    shape storage
                    color green
                }
            }
        }
    }

    externalSystems = boundary "External systems" {
        style {
        color amber
        }
        intersolve = softwareSystem "Intersolve" {
            technology "HTTPS"
            summary "External voucher processing partner APIs (slow, no bulk queries)"
            style {
                color amber
            }
        }

        selligent = softwareSystem "Selligent" {
            technology "HTTPS"
            summary "Email marketing platform"
            style {
                color amber
            }
        }
    }

    customer -> apps "uses"
    employee -> pos "operates"

    apps -> loyaltyApi "Activate / Redeem" {
        technology "HTTPS"
    }
    pos -> loyaltyApi "Activate / Redeem" {
        technology "HTTPS"
    }

    loyaltyApi -> intersolve "Activates / Redeems vouchers" {
        technology "HTTPS"
    }

    vms -> intersolve "Creates / Updates vouchers" {
        technology "HTTPS"
    }

    vms -> selligent "Voucher data for email templates" 

    vms -> kafka "Publish voucher lifecycle events"{
        style {
            color green
        }
    }

    loyaltyApi -> kafka "Publish voucher lifecycle events" {
        style {
            color green
        }
    }

    kafka -> ces "Event consumption" {
        style {
            color green
        }
    }

    kafka -> sync "Voucher lifecycle events" {
        style {
            color green
        }
    }

    sync -> reminderDb "Upsert voucher state" {
        style {
            color green
        }
    }

    backfill -> intersolve "One-time, rate-limited read" {
        style {
            color green
        }
    }

    backfill -> reminderDb "seed / reconcile local state" {
        style {
            color green
        }
    }

    worker -> rules "read config / reminder timings" {
        style {
            color green
        }
    }

    worker -> reminderDb "find due reminders, mark sent" {
        style {
            color green
        }
    }

    worker -> kafka "Publish reminder events" {
        style {
            color green
        }
    }

    ces -> selligent "Dispatch emails"

    sync -> dlq "unprocessable event, after retries" {
        style {
            color red
        }
    }

    ces -> dlq "undeliverable/failed emails, after retries" {
        style {
            color red
        }
    }


}

views {
    view index {
        title "01 - System Context"
        autoLayout TopBottom

        include customer
        include employee
        include hema
        include externalSystems, externalSystems.*
    }

    view containers of hema {
        title "02 - Containers"

        include customer
        include employee
        include hema, hema.*
        include externalSystems, externalSystems.*
    }

    view intersolveBoundary {
        title "03 - Intersolve boundary"
        description "Every path that touches the Intersolve API"
        autoLayout TopBottom

        include intersolve
        include loyaltyApi, vms 
        include reminderService, backfill
    }

    dynamic view syncState {
        title "04 - Keeping local state in sync"
        autoLayout TopBottom

        apps -> loyaltyApi "Customer redeems voucher"
        pos -> loyaltyApi "POS activates voucher"

        loyaltyApi -> intersolve "Redeem voucher"

        loyaltyApi -> kafka "Publish VoucherRedeemed event" {
            notes "Published after redemption succeeds and off the response path to prevent blocking customer."
        }

        kafka -> sync "Consume lifecycle event"

        sync -> reminderDb "Apply update, guarded by event version" {
            notes "Status precedence / version guard: a late VoucherUpdated must not revive a redeemed voucher."
        }
    }

    dynamic view dailyReminder {
        title "05 - Daily reminder run"
        autoLayout TopBottom

        worker -> rules "Load reminder timing for voucher type"

        worker -> reminderDb "Query vouchers due for reminding" {
            notes "Indexed on reminder date. No external calls to Intersolve or LoyaltyAPI"
        }

        worker -> kafka "Publish reminder event"{
            notes "Idempotency key = voucher id + due date, so a retry can never send a second email."
        }

        kafka -> ces "Deliver reminder event"

        ces -> selligent "Send reminder email"

        worker -> reminderDb "Mark reminder sent" {
            notes "Tracked in local state to avoid duplicates. Failed sends stay retryable and land in DLQ instead of being lost."
        }
    }

    dynamic view backfillRun {
        title "06 - Backfill & reconcilliation"
        autoLayout TopBottom

        backfill -> intersolve "Page through existing vouchers (rate-limited)" {
            notes "One-time seed of 3.2m existing vouchers. With no bulk API this is SLOW. Run in background and make resumable. Prefer export if Intersolve offers one."
        }

        intersolve -> backfill "Voucher data"

        backfill -> reminderDb "Insert or repair local state" {
            notes "Can also run periodically to reconcile drift between local state and Intersolve."
        }
    }

    dynamic view emailFailure {
        title "07 - Reminder email failure"
        autoLayout TopBottom

        ces -> selligent "Send reminder email" {
            notes "Retried with backoff on timeout. Idempotency key travels with send, so a retry after Selligent timeout can never send the same email twice."
        }

        selligent -> ces "Timeout / failure"

        ces -> dlq "Park after N retries" {
            notes "Nothing is silently dropped. Parked items are replayable once cause is fixed. Alert if DLQ grows or reminders sit overdue."
        }
    }

    dynamic view eventFailure {
        title "08 - Lifecycle event failure"
        autoLayout TopBottom

        kafka -> sync "Consume lifecycle event"

        sync -> dlq "Park unprocessable event after N tries" {
            notes "Events that can't be applied land here instead of blocking the stream."
        }

        backfill -> reminderDb "Nightly reconciliation repairs state" {
            notes "Safety net: because local state is rebuilt fro, Intersolve, a lost or parked event can never permanently lose a reminder. It simply fires on the next daily run."
        }
    }
}
